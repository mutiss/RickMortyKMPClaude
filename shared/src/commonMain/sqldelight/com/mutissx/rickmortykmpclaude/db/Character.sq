CREATE TABLE IF NOT EXISTS CharacterEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    imageUrl TEXT NOT NULL,
    status TEXT NOT NULL,
    species TEXT NOT NULL,
    gender TEXT NOT NULL,
    originName TEXT NOT NULL,
    locationName TEXT NOT NULL,
    episodeUrls TEXT NOT NULL,
    page INTEGER NOT NULL
);

selectPaged:
SELECT * FROM CharacterEntity
WHERE (:query = '' OR name LIKE '%' || :query || '%')
ORDER BY page ASC, id ASC
LIMIT :limit OFFSET :offset;

countAll:
SELECT COUNT(*) FROM CharacterEntity
WHERE (:query = '' OR name LIKE '%' || :query || '%');

getMaxPage:
SELECT MAX(page) FROM CharacterEntity;

selectById:
SELECT * FROM CharacterEntity WHERE id = :id LIMIT 1;

insertCharacter:
INSERT OR REPLACE INTO CharacterEntity(id, name, imageUrl, status, species, gender, originName, locationName, episodeUrls, page)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAll:
DELETE FROM CharacterEntity;
